    <string name="hy2_help_server">Required for a direct server. Mutually exclusive with Realm; switching mode clears the other side.</string>
    <string name="hy2_help_port">1–65535. Once port hopping is set, sing-box ignores this and it is omitted on save.</string>
    <string name="hy2_help_ports">Several ranges. sing-box wants start:end; a single port is stored as n:n. Empty means the single port above.</string>
    <string name="hy2_help_hop">Empty means 30s. Used only when port hopping is set.</string>
    <string name="hy2_help_hop_max">New in 1.14. When set, the hop interval is chosen at random between the two values.</string>
    <string name="hy2_help_bandwidth">Empty selects BBR instead of Brutal. 0 is omitted from the config.</string>
    <string name="hy2_help_bbr">New in 1.14. Empty means standard. Meaningful when bandwidth is left empty.</string>
    <string name="hy2_help_password">Auth password. Official userpass is the whole username:password string.</string>
    <string name="hy2_help_obfs">salamander, or gecko (new in 1.14). Empty disables obfuscation.</string>
    <string name="hy2_help_obfs_password">Required once obfuscation is on. sing-box refuses to start without it.</string>
    <string name="hy2_help_gecko">Gecko only. Empty uses 512 and 1200.</string>
    <string name="hy2_help_network">Empty enables both TCP and UDP.</string>
    <string name="hy2_help_brutal">Logs Hysteria Brutal congestion-control debug information.</string>
    <string name="hy2_help_parrot">New in 1.14. Chrome QUIC imitation is on by default. Turning this on stops forcing idle_timeout to 30s. Chrome does not offer Ed25519, so those certificates fail the handshake.</string>
    <string name="hy2_help_sni">TLS server name. In Realm mode the default is the rendezvous host; set the name on the Hysteria2 certificate.</string>
    <string name="hy2_help_insecure">Do not verify the server certificate. Share links use insecure=1.</string>
    <string name="hy2_help_alpn">Comma-separated, for example h3.</string>
    <string name="hy2_help_tls_version">1.0, 1.1, 1.2, or 1.3. Empty leaves the sing-box default.</string>
    <string name="hy2_help_ciphers">Comma-separated cipher suite names.</string>
    <string name="hy2_help_curves">P256, P384, P521, X25519, X25519MLKEM768, comma-separated.</string>
    <string name="hy2_help_ca">PEM. Paste several certificates in a row, or set a file path instead.</string>
    <string name="hy2_help_pin">SHA-256 of the certificate public key. 64 hex digits (pinSHA256) or Base64. Hex is converted to Base64 for sing-box. Separate several pins with commas.</string>
    <string name="hy2_help_client">PEM for mutual TLS, or a path on the device.</string>
    <string name="hy2_help_handshake">For example 5s. Empty uses the sing-box default.</string>
    <string name="hy2_help_ech">Encrypted Client Hello. The config may be PEM or the ech parameter from an official link.</string>
    <string name="hy2_help_utls">The fingerprint must be one sing-box lists. utls.enabled is written only when this is on.</string>
    <string name="hy2_help_quic">Empty fields are omitted. While Chrome imitation is on, idle_timeout is forced to 30s and some window values are replaced with Chrome\'s.</string>
    <string name="hy2_help_windows">A size such as 8388608 or 8MB.</string>
    <string name="hy2_help_detour">Use another node as upstream. The generator writes the tag node-id. Other dial fields are omitted.</string>
    <string name="hy2_help_resolver">DNS server tag. Domain STUN servers and a domain server address use it. A bare tag is written as a string; strategy or timeout makes it an object.</string>
    <string name="hy2_help_strategy">prefer_ipv4, prefer_ipv6, ipv4_only, ipv6_only. This is domain_resolver.strategy, not the removed domain_strategy.</string>
    <string name="hy2_help_bind">Bind an interface or address. Conflicts with network strategy.</string>
    <string name="hy2_help_net_strategy">default, hybrid, or fallback. Android and iOS graphical clients only, and route.auto_detect_interface must be on. Conflicts with interface binding.</string>
    <string name="hy2_help_net_type">wifi, cellular, ethernet, other, comma-separated.</string>
    <string name="hy2_help_fallback">Used only when a network strategy or resolve strategy is set. Empty means 300ms.</string>
    <string name="hy2_help_udp_fragment">Empty means the field is omitted.</string>
    <string name="hy2_help_realm_url">http or https. realm:// imports as https (port 443). realm+http:// imports as http (port 80).</string>
    <string name="hy2_help_realm_token">Bearer token matching users[].token. Official links put it in the userinfo.</string>
    <string name="hy2_help_realm_id">The slot name the server registered. One path segment.</string>
    <string name="hy2_help_stun">Required. One host or host:port per line. Saving fails when this is empty. A new node starts with the official client\'s three defaults.</string>
    <string name="hy2_help_ip">0 means both. 6 conflicts with port mapping.</string>
    <string name="hy2_help_portmap">Keep a UDP mapping with UPnP or NAT-PMP. Empty timeout is 10s. Empty lifetime is 10m.</string>
    <string name="hy2_help_http">0 omits the field. 1, 2, or 3 writes version. A tag references an existing client. The two cannot both be set.</string>
    <string name="hy2_section_tls">TLS</string>
    <string name="hy2_section_quic">QUIC</string>
    <string name="hy2_section_dial">Dial</string>
    <string name="hy2_err_realm_conflicts_server">Realm conflicts with server, port, and port hopping. Tap the current mode again to clear the other side.</string>
    <string name="hy2_err_realm_url_required">The rendezvous URL must be http or https and include a host.</string>
    <string name="hy2_err_realm_id_required">Realm ID is required.</string>
    <string name="hy2_err_stun_required">sing-box requires STUN servers.</string>
    <string name="hy2_err_bad_ip_version">IP version must be 0, 4, or 6.</string>
    <string name="hy2_err_port_mapping_ipv6">Port mapping needs IPv4 and conflicts with IP version 6.</string>
    <string name="hy2_err_server_required">Direct mode needs a server.</string>
    <string name="hy2_err_port_required">Without port hopping, the port must be from 1 to 65535.</string>
    <string name="hy2_err_ports_conflict">Port hopping and a single port cannot both be written.</string>
    <string name="hy2_err_bad_port_range">Each range must be start:end, and the start must not exceed the end.</string>
    <string name="hy2_err_hop_without_ports">Hop intervals apply only when port hopping is set.</string>
    <string name="hy2_err_bad_obfs">Obfuscation must be salamander or gecko.</string>
    <string name="hy2_err_obfs_password_required">Obfuscation requires a password.</string>
    <string name="hy2_err_gecko_size">The gecko minimum packet size cannot exceed the maximum.</string>
    <string name="hy2_err_bad_network">Network must be both, tcp, or udp.</string>
    <string name="hy2_err_bad_bbr">BBR profile must be conservative, standard, or aggressive.</string>
    <string name="hy2_err_bad_tls_version">TLS version must be 1.0 through 1.3.</string>
    <string name="hy2_err_bad_fingerprint">This uTLS fingerprint is not in the sing-box 1.14.4 enum.</string>
    <string name="hy2_err_bad_strategy">Resolve strategy is not one of the four allowed values.</string>
    <string name="hy2_err_bad_duration">Durations look like 30s, 10m, or 300ms.</string>
    <string name="hy2_err_bad_network_strategy">Network strategy must be default, hybrid, or fallback.</string>
    <string name="hy2_err_bad_network_type">Network type must be wifi, cellular, ethernet, or other.</string>
    <string name="hy2_err_strategy_conflicts_bind">Network strategy conflicts with a bound interface or address.</string>
    <string name="hy2_err_fallback_without_strategy">Fallback delay applies only when a network or resolve strategy is set.</string>
    <string name="hy2_err_http_client_conflict">Set either an HTTP client tag or a version, not both.</string>
